NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
WORKFORCE_CORS_ORIGIN=http://localhost:5173
PATIENT_CORS_ORIGIN=http://localhost:5173
ENABLE_API_DOCS=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
DATABASE_URL=postgresql://uae_health:local-development-only@127.0.0.1:5433/uae_health
DATABASE_MAX_CONNECTIONS=5
DATABASE_SSL=false
ALLOW_SYNTHETIC_SEED=true
AUTH_MODE=disabled
PATIENT_AUTH_MODE=disabled
DEPLOYMENT_ENVIRONMENT=local
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
PATIENT_COGNITO_USER_POOL_ID=
PATIENT_COGNITO_USER_POOL_CLIENT_ID=
# Public patient registration is disabled by default. For local synthetic QA only,
# set this to true and use a noncommitted, 32+ character HMAC secret.
PATIENT_PUBLIC_REGISTRATION_ENABLED=false
PATIENT_REGISTRATION_EMAIL_HMAC_SECRET=
PATIENT_PORTAL_PUBLIC_URL=http://localhost:5173/patient-portal
PATIENT_PUBLIC_REGISTRATION_WINDOW_SECONDS=900
PATIENT_PUBLIC_REGISTRATION_IP_LIMIT=5
PATIENT_PUBLIC_REGISTRATION_EMAIL_LIMIT=3
PATIENT_PORTAL_INVITATION_TTL_MINUTES=10080
SYNTHETIC_ADMIN_COGNITO_SUBJECT=
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480
SESSION_RENEWAL_MINUTES=5
